[Unit]
Description=Resolve the Music TV playlist files into musictv_cache.json
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=@USER@
# Module-local path, substituted at install time: the script ships inside the
# module, so it lands wherever the module is installed. Same reasoning as the
# HDHomeRun scanner unit — a hardcoded /home/<user>/240-MP breaks silently the
# day the install moves, and a failing timer is invisible.
ExecStart=/usr/bin/python3 @MODULE_DIR@/scripts/musictv_fetch.py
# Bug conversion is cheap and has no network dependency, but a fresh install
# has neither cache nor .bgra files, so do both here and the first run leaves a
# working channel.
ExecStart=/usr/bin/python3 @MODULE_DIR@/scripts/musictv_bugs.py
# Without this the per-playlist progress lines are buffered until exit, so a
# long yt-dlp run looks like it did nothing.
Environment=PYTHONUNBUFFERED=1
# yt-dlp on a 1GB Pi should never compete with playback.
Nice=10
