[Unit]
Description=Watch the Music TV playlist files for edits
# Paired with musictv-fetch.service. Editing musictv_playlists.txt over SSH should put
# the new videos on air without waiting for the daily timer, and there is no
# in-app path to trigger it: 240-MP modules with no C++ backend cannot spawn a
# process from QML.

[Path]
# PathChanged, not PathModified: one trigger when the editor closes the file,
# not one per write() during the save.
PathChanged=@HOME@/.local/share/240-MP/musictv_playlists.txt
PathChanged=@HOME@/.local/share/240-MP/musictv_bumpers.txt
PathChanged=@HOME@/.local/share/240-MP/musictv_metadata.json

[Install]
WantedBy=default.target
