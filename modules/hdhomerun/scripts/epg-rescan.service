[Unit]
Description=HDHomeRun guide rescan requested from the 240-MP UI
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=@USER@
# Deliberately no [Install] section: this is started by epg-rescan.path, never
# enabled directly. Enabling it would run a scan at every boot.
#
# @MODULE_DIR@ is substituted with the real install path at install time.
# These units used to hardcode /home/vcr/240-MP, which broke the moment the
# source checkout was deleted in favour of an install.sh install — and broke
# silently, because a failing timer says nothing on screen.
ExecStart=/usr/bin/python3 @MODULE_DIR@/scripts/epg-rescan-trigger.py
Environment=EPG_CACHE_PATH=@HOME@/.local/share/240-MP/epg_cache.json
Environment=EPG_SCANNER=@MODULE_DIR@/scripts/epg_scanner.py
# Python block-buffers stdout to a pipe, so the trigger's own messages ("scanning
# tuner x") would only reach the journal when it exits — an hour after the fact,
# and after the scanner's own lines, making the log read as though the scanner had
# been invoked directly. Unbuffer so progress is live.
Environment=PYTHONUNBUFFERED=1
# One capture ties up a tuner for 150s. Stay below viewing in priority; with a
# 2-tuner device one stays free.
Nice=10
