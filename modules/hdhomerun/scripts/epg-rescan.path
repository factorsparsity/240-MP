[Unit]
Description=Watch 240-MP config for an HDHomeRun guide-rescan request
# Paired with epg-rescan.service. This is how the in-app "Rescan Guide Data"
# toggle reaches a process: QML can write a setting but cannot spawn anything
# (240-MP has no QProcess), so the app flips a flag in config.json and systemd
# picks it up here.

[Path]
# PathChanged, not PathModified: we want one trigger when the app closes the
# file after writing, not a trigger per write() during it.
PathChanged=@HOME@/.local/share/240-MP/config.json

[Install]
WantedBy=default.target
